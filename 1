local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local pet = workspace:WaitForChild("Pet")

-- Chọn Part chính của Pet
local root = pet.PrimaryPart or pet:FindFirstChild("Body") or pet:FindFirstChildWhichIsA("BasePart")

if not root then
	warn("Pet chưa có Part/Body!")
	return
end

pet.PrimaryPart = root

-- Cho toàn bộ Pet không va chạm
for _, obj in ipairs(pet:GetDescendants()) do
	if obj:IsA("BasePart") then
		obj.Anchored = true
		obj.CanCollide = false
	end
end

local player = Players:GetPlayers()[1]

RunService.Heartbeat:Connect(function()
	if not player then
		player = Players:GetPlayers()[1]
	end

	if not player then return end

	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")

	if not hrp then return end

	-- Vị trí Pet phía sau người chơi
	local target = hrp.CFrame * CFrame.new(3, 1.5, 3)

	local current = pet:GetPivot()
	local newCF = current:Lerp(target, 0.12)

	pet:PivotTo(newCF)
end)
