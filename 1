local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local equipEvent = ReplicatedStorage:WaitForChild("EquipPet")

local gui = script.Parent

-- Nút mở Pet
local open = Instance.new("TextButton")
open.Name = "OpenPet"
open.Size = UDim2.fromOffset(70, 45)
open.Position = UDim2.new(0, 15, 0.5, -20)
open.Text = "🐾 PET"
open.TextScaled = true
open.Parent = gui

local corner = Instance.new("UICorner")
corner.Parent = open

-- Menu
local frame = Instance.new("Frame")
frame.Name = "PetInventory"
frame.Size = UDim2.new(0, 330, 0, 300)
frame.Position = UDim2.new(0.5, -165, 0.5, -150)
frame.Visible = false
frame.Parent = gui

local frameCorner = Instance.new("UICorner")
frameCorner.CornerRadius = UDim.new(0, 12)
frameCorner.Parent = frame

-- Tiêu đề
local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 50)
title.BackgroundTransparency = 1
title.Text = "🐾 PET INVENTORY"
title.TextScaled = true
title.Font = Enum.Font.GothamBold
title.Parent = frame

-- Pet
local petButton = Instance.new("TextButton")
petButton.Size = UDim2.new(1, -30, 0, 80)
petButton.Position = UDim2.new(0, 15, 0, 65)
petButton.Text = "🐉 Dragon\n⭐ Legendary | Power: 10"
petButton.TextScaled = true
petButton.Parent = frame

local petCorner = Instance.new("UICorner")
petCorner.CornerRadius = UDim.new(0, 10)
petCorner.Parent = petButton

-- Equip
local equip = Instance.new("TextButton")
equip.Size = UDim2.new(0.8, 0, 0, 50)
equip.Position = UDim2.new(0.1, 0, 1, -65)
equip.Text = "EQUIP"
equip.TextScaled = true
equip.Font = Enum.Font.GothamBold
equip.Parent = frame

local equipCorner = Instance.new("UICorner")
equipCorner.Parent = equip

-- Mở / đóng
open.MouseButton1Click:Connect(function()
	frame.Visible = not frame.Visible
end)

-- Chọn Pet
petButton.MouseButton1Click:Connect(function()
	petButton.Text = "✅ Dragon\n⭐ Legendary | Power: 10"
end)

-- Equip
equip.MouseButton1Click:Connect(function()
	equipEvent:FireServer()

	equip.Text = "✅ EQUIPPED"

	task.wait(1)

	equip.Text = "UNEQUIP"
end)
