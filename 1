local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local petsFolder = ReplicatedStorage:WaitForChild("Pets")
local equipEvent = ReplicatedStorage:WaitForChild("EquipPet")

local equipped = {}

local function equipPet(player)
	local character = player.Character
	if not character then return end

	local oldPet = workspace:FindFirstChild(player.Name .. "_Pet")
	if oldPet then
		oldPet:Destroy()
	end

	local template = petsFolder:FindFirstChild("Pet")
	if not template then
		warn("Không tìm thấy Pet trong ReplicatedStorage > Pets")
		return
	end

	local pet = template:Clone()
	pet.Name = player.Name .. "_Pet"
	pet.Parent = workspace

	equipped[player] = pet

	local root = pet.PrimaryPart
		or pet:FindFirstChild("Body")
		or pet:FindFirstChildWhichIsA("BasePart")

	if root then
		pet.PrimaryPart = root
	end
end

equipEvent.OnServerEvent:Connect(function(player)
	equipPet(player)
end)

Players.PlayerRemoving:Connect(function(player)
	equipped[player] = nil
end)
