--============================================================--
-- BASIC FUNCTIONS
--============================================================--

local function getRoot(obj)
    if not obj then
        return nil
    end

    if obj:IsA("BasePart") then
        return obj
    end

    if obj:IsA("Model") then
        return obj.PrimaryPart
            or obj:FindFirstChild("HumanoidRootPart")
            or obj:FindFirstChildWhichIsA("BasePart", true)
    end

    if obj:IsA("Tool") then
        return obj:FindFirstChild("Handle")
            or obj:FindFirstChildWhichIsA("BasePart", true)
    end

    return obj:FindFirstChildWhichIsA("BasePart", true)
end

local function getDistance(obj)
    local root = getRoot(obj)
    local char = Player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    if not root or not hrp then
        return math.huge
    end

    return (root.Position - hrp.Position).Magnitude
end

local function lower(v)
    return string.lower(tostring(v or ""))
end

local function formatNumber(v)
    v = tonumber(v)

    if not v then
        return "?"

    elseif math.abs(v) >= 1e12 then
        return string.format("%.2fT", v / 1e12)

    elseif math.abs(v) >= 1e9 then
        return string.format("%.2fB", v / 1e9)

    elseif math.abs(v) >= 1e6 then
        return string.format("%.2fM", v / 1e6)

    elseif math.abs(v) >= 1e3 then
        return string.format("%.2fK", v / 1e3)
    end

    return string.format("%.0f", v)
end

--============================================================--
-- DATA READER
--============================================================--

local function getData(obj, names)

    for _, name in ipairs(names) do

        local attribute = obj:GetAttribute(name)

        if attribute ~= nil then
            return attribute
        end

        local child = obj:FindFirstChild(name, true)

        if child and child:IsA("ValueBase") then
            return child.Value
        end
    end

    return nil
end

--============================================================--
-- EGG DETECTION
--============================================================--

local EggWords = {
    "egg",
    "trung",
    "eggbox",
    "egg box",
    "hatch",
    "hatching",
}

local function isEgg(obj)

    if not obj then
        return false
    end

    local explicit = getData(obj, {
        "IsEgg",
        "Egg",
        "EggType",
        "EggName",
        "Hatchable",
        "IsHatchable",
    })

    if explicit ~= nil then

        if typeof(explicit) == "boolean" then
            return explicit
        end

        return true
    end

    local name = lower(obj.Name)

    for _, word in ipairs(EggWords) do
        if string.find(name, word, 1, true) then
            return true
        end
    end

    return false
end

local function getEggRank(obj)

    local rank = getData(obj, {
        "Rank",
        "Rarity",
        "RarityName",
        "Tier",
        "TierName",
        "Grade",
        "GradeName",
        "EggRank",
    })

    if rank ~= nil then
        return tostring(rank)
    end

    return "Unknown"
end

local function getEggPet(obj)

    local pet = getData(obj, {
        "Pet",
        "PetName",
        "PetType",
        "HatchPet",
        "Reward",
        "RewardName",
        "PossiblePet",
    })

    if pet ~= nil then
        return tostring(pet)
    end

    return "Unknown"
end

local function getEggPrice(obj)

    return getData(obj, {
        "Price",
        "Cost",
        "EggPrice",
        "BuyPrice",
    })
end

--============================================================--
-- INTERACTION
--============================================================--

local function hasInteraction(obj)

    if obj:FindFirstChildWhichIsA("ProximityPrompt", true) then
        return true
    end

    if obj:FindFirstChildWhichIsA("ClickDetector", true) then
        return true
    end

    if obj:FindFirstChildWhichIsA("TouchTransmitter", true) then
        return true
    end

    return false
end

--============================================================--
-- CLASSIFY
--============================================================--

local function classify(obj)

    if not obj then
        return nil
    end

    if obj == ESPFolder then
        return nil
    end

    if Player.Character
        and obj:IsDescendantOf(Player.Character) then
        return nil
    end

    if isEgg(obj) then
        return "Egg"
    end

    local humanoid = obj:FindFirstChildOfClass("Humanoid")

    if humanoid then

        if hasInteraction(obj) then
            return "NPC"
        end

        return "Monster"
    end

    if hasInteraction(obj) then
        return "Interactable"
    end

    if obj:IsA("Tool") then
        return "Item"
    end

    return nil
end

--============================================================--
-- GET LOGICAL OBJECT
--============================================================--

local function logicalObject(obj)

    if obj:IsA("Model") then
        return obj
    end

    if obj:IsA("Tool") then
        return obj
    end

    if obj:IsA("BasePart") then

        local parent = obj.Parent

        if parent and parent:IsA("Model") then
            return parent
        end

        return obj
    end

    return nil
end

--============================================================--
-- COLOR
--============================================================--

local function eggColor(rank)

    local r = lower(rank)

    if string.find(r, "secret", 1, true) then
        return Color3.fromRGB(255, 50, 50)

    elseif string.find(r, "divine", 1, true) then
        return Color3.fromRGB(255, 0, 255)

    elseif string.find(r, "exclusive", 1, true) then
        return Color3.fromRGB(255, 215, 0)

    elseif string.find(r, "myth", 1, true) then
        return Color3.fromRGB(255, 80, 0)

    elseif string.find(r, "legend", 1, true) then
        return Color3.fromRGB(255, 200, 0)

    elseif string.find(r, "epic", 1, true) then
        return Color3.fromRGB(180, 80, 255)

    elseif string.find(r, "rare", 1, true) then
        return Color3.fromRGB(60, 150, 255)

    elseif string.find(r, "uncommon", 1, true) then
        return Color3.fromRGB(60, 220, 100)
    end

    return Color3.new(1,1,1)
end

local function categoryColor(category, obj)

    if category == "Egg" then
        return eggColor(getEggRank(obj))
    elseif category == "Monster" then
        return Color3.fromRGB(255,70,70)
    elseif category == "NPC" then
        return Color3.fromRGB(80,180,255)
    elseif category == "Interactable" then
        return Color3.fromRGB(80,255,150)
    elseif category == "Item" then
        return Color3.fromRGB(255,220,60)
    end

    return Color3.new(1,1,1)
end

--============================================================--
-- SHOULD SHOW
--============================================================--

local function enabled(category)

    if category == "Egg" then
        return Config.EggESP

    elseif category == "Monster" then
        return Config.MonsterESP

    elseif category == "NPC" then
        return Config.NPCESP

    elseif category == "Item" then
        return Config.ItemESP

    elseif category == "Interactable" then
        return Config.InteractableESP
    end

    return false
end

--============================================================--
-- DESTROY ESP
--============================================================--

local function removeESP(obj)

    local data = ESP[obj]

    if not data then
        return
    end

    if data.Gui then
        data.Gui:Destroy()
    end

    if data.Highlight then
        data.Highlight:Destroy()
    end

    ESP[obj] = nil
end

--============================================================--
-- CREATE ESP
--============================================================--

local function createESP(obj, category)

    if ESP[obj] then
        return
    end

    if not enabled(category) then
        return
    end

    local root = getRoot(obj)

    if not root then
        return
    end

    local gui = Instance.new("BillboardGui")
    gui.Name = "ESP"
    gui.Adornee = root
    gui.Size = UDim2.fromOffset(260, 130)
    gui.StudsOffset = Vector3.new(0,3,0)
    gui.AlwaysOnTop = true
    gui.MaxDistance = Config.MaxDistance
    gui.Parent = ESPFolder

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = UDim2.fromScale(1,1)
    label.TextColor3 = categoryColor(category,obj)
    label.TextStrokeTransparency = 0
    label.TextStrokeColor3 = Color3.new(0,0,0)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    label.TextWrapped = true
    label.Parent = gui

    local highlight

    if Config.Highlight then

        highlight = Instance.new("Highlight")
        highlight.Adornee = obj
        highlight.FillTransparency = 0.8
        highlight.OutlineTransparency = 0
        highlight.OutlineColor = categoryColor(category,obj)
        highlight.Parent = ESPFolder

    end

    ESP[obj] = {
        Gui = gui,
        Label = label,
        Highlight = highlight,
        Category = category,
    }
end

--============================================================--
-- UPDATE ESP TEXT
--============================================================--

local function updateESP(obj,data)

    if not obj.Parent then
        removeESP(obj)
        return
    end

    if not enabled(data.Category) then
        removeESP(obj)
        return
    end

    local distance = getDistance(obj)

    if distance > Config.MaxDistance then
        data.Gui.Enabled = false

        if data.Highlight then
            data.Highlight.Enabled = false
        end

        return
    end

    data.Gui.Enabled = true

    if data.Highlight then
        data.Highlight.Enabled = Config.Highlight
    end

    local lines = {}

    if data.Category == "Egg" then

        local eggName = getData(obj,{
            "EggName",
            "EggType",
            "DisplayName",
        }) or obj.Name

        table.insert(lines,"🥚 "..tostring(eggName))

        if Config.EggRank then
            table.insert(
                lines,
                "⭐ "..getEggRank(obj)
            )
        end

        if Config.EggPet then
            table.insert(
                lines,
                "🐾 Pet: "..getEggPet(obj)
            )
        end

        if Config.EggPrice then
            local price = getEggPrice(obj)

            if price ~= nil then
                table.insert(
                    lines,
                    "💰 $"..formatNumber(price)
                )
            end
        end

        if Config.EggDistance then
            table.insert(
                lines,
                "📏 "..math.floor(distance).."m"
            )
        end

    else

        if Config.ShowName then
            table.insert(lines,obj.Name)
        end

        if Config.ShowHP then

            local hum = obj:FindFirstChildOfClass("Humanoid")

            if hum then
                table.insert(
                    lines,
                    "❤️ "..math.floor(hum.Health)
                    .."/"
                    ..math.floor(hum.MaxHealth)
                )
            end

        end

        if Config.ShowDistance then
            table.insert(
                lines,
                "📏 "..math.floor(distance).."m"
            )
        end

    end

    data.Label.Text = table.concat(lines,"\n")
end

--============================================================--
-- QUEUE SCANNER
--============================================================--

local function addQueue(obj)

    if Cache[obj] then
        return
    end

    Cache[obj] = true
    table.insert(Queue,obj)
end

local function buildQueue()

    table.clear(Queue)
    QueueIndex = 1

    for _,obj in ipairs(Workspace:GetDescendants()) do
        addQueue(obj)
    end
end

local function processQueue()

    local processed = 0

    while QueueIndex <= #Queue
        and processed < Config.ScanPerFrame do

        local obj = Queue[QueueIndex]
        QueueIndex += 1
        processed += 1

        if obj and obj.Parent then

            local logical = logicalObject(obj)

            if logical then

                local category = classify(logical)

                if category then

                    if enabled(category) then
                        createESP(logical,category)
                    end

                end
            end
        end
    end

    if QueueIndex > #Queue then
        table.clear(Queue)
        QueueIndex = 1
    end
end

--============================================================--
-- NEW OBJECT EVENT
--============================================================--

Workspace.DescendantAdded:Connect(function(obj)

    -- Small deferred operation instead of rescanning Workspace
    task.defer(function()

        if obj and obj.Parent then
            addQueue(obj)
        end

    end)

end)

Workspace.DescendantRemoving:Connect(function(obj)

    Cache[obj] = nil

    if ESP[obj] then
        removeESP(obj)
    end

end)

--============================================================--
-- MONEY
--============================================================--

local MoneyObject
local LastMoney
local LastMoneyTime
local MoneyPerSecondValue = 0

local function findMoney()

    local leaderstats = Player:FindFirstChild("leaderstats")

    if leaderstats then

        for _,v in ipairs(leaderstats:GetChildren()) do

            if v:IsA("ValueBase") then

                local n = lower(v.Name)

                if string.find(n,"money",1,true)
                    or string.find(n,"cash",1,true)
                    or string.find(n,"coin",1,true)
                    or string.find(n,"gold",1,true) then

                    return v
                end
            end
        end
    end

    return nil
end

local function updateMoney()

    MoneyObject = MoneyObject or findMoney()

    if not MoneyObject then
        return
    end

    local value = tonumber(MoneyObject.Value)

    if not value then
        return
    end

    local now = os.clock()

    if LastMoney and LastMoneyTime then

        local dt = now - LastMoneyTime

        if dt > 0 then
            MoneyPerSecondValue =
                (value - LastMoney) / dt
        end

    end

    LastMoney = value
    LastMoneyTime = now
end

