-- TOGGLE
--============================================================--

local function toggle(text,key)

    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1,-5,0,40)
    button.BackgroundColor3 = Color3.fromRGB(35,35,35)
    button.TextColor3 = Color3.new(1,1,1)
    button.Font = Enum.Font.GothamBold
    button.TextSize = 14
    button.Parent = Scroll

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0,8)
    corner.Parent = button

    local function refresh()

        -- IMPORTANT:
        -- OFF = false
        -- ON = true
        if Config[key] then
            button.Text = text.."  [ON]"
            button.BackgroundColor3 =
                Color3.fromRGB(35,85,45)
        else
            button.Text = text.."  [OFF]"
            button.BackgroundColor3 =
                Color3.fromRGB(35,35,35)
        end

    end

    refresh()

    button.MouseButton1Click:Connect(function()

        Config[key] = not Config[key]

        refresh()

        -- Không fullScan ở đây
        -- Chỉ xử lý ESP đã có + queue mới
        if not Config[key] then

            for obj,data in pairs(ESP) do

                if data.Category == "Egg"
                    and key:sub(1,3) == "Egg" then

                    -- Egg ESP master off
                    if key == "EggESP" then
                        removeESP(obj)
                    end

                elseif data.Category == "Monster"
                    and key == "MonsterESP" then

                    removeESP(obj)

                elseif data.Category == "NPC"
                    and key == "NPCESP" then

                    removeESP(obj)

                elseif data.Category == "Item"
                    and key == "ItemESP" then

                    removeESP(obj)

                elseif data.Category == "Interactable"
                    and key == "InteractableESP" then

                    removeESP(obj)
                end

            end

        else

            -- Chỉ thêm object hiện có vào queue
            for _,obj in ipairs(Workspace:GetDescendants()) do
                addQueue(obj)
            end

        end

    end)

    return button
end

