--============================================================--
-- PERFORMANCE LOOP
--============================================================--

local updateTimer = 0
local scanTimer = 0

RunService.Heartbeat:Connect(function(dt)

    -- Scan queue slowly
    scanTimer += dt

    if scanTimer >= Config.ScanDelay then
        scanTimer = 0
        processQueue()
    end

    -- ESP update throttled
    updateTimer += dt

    if updateTimer >= Config.UpdateInterval then

        updateTimer = 0

        for obj,data in pairs(ESP) do
            updateESP(obj,data)
        end

        if Config.MoneyESP
            or Config.MoneyPerSecond then

            updateMoney()

            local text = ""

            if Config.MoneyESP then

                if MoneyObject then

                    text =
                        "💰 Money: $"
                        ..formatNumber(MoneyObject.Value)

                else
                    text = "💰 Money: ?"
                end

            end

            if Config.MoneyPerSecond then

                if text ~= "" then
                    text ..= "\n"
                end

                text =
                    text
                    .."💸 Money/s: $"
                    ..formatNumber(MoneyPerSecondValue)

            end

            MoneyLabel.Text = text

        else

            MoneyLabel.Text = "💰 Money: OFF"

