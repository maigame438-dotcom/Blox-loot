local Players = game:GetService("Players")
local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "PetGUI"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local button = Instance.new("TextButton")
button.Size = UDim2.fromOffset(100, 50)
button.Position = UDim2.new(0, 20, 0.5, 0)
button.Text = "🐾 PET"
button.TextScaled = true
button.BackgroundTransparency = 0
button.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = button

local menu = Instance.new("Frame")
menu.Size = UDim2.fromOffset(330, 300)
menu.Position = UDim2.new(0.5, -165, 0.5, -150)
menu.Visible = false
menu.Parent = gui

local menuCorner = Instance.new("UICorner")
menuCorner.CornerRadius = UDim.new(0, 15)
menuCorner.Parent = menu

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 55)
title.BackgroundTransparency = 1
title.Text = "🐾 PET INVENTORY"
title.TextScaled = true
title.Parent = menu

local pet = Instance.new("TextButton")
pet.Size = UDim2.new(1, -30, 0, 90)
pet.Position = UDim2.fromOffset(15, 70)
pet.Text = "🐉 Dragon\n⭐ Legendary\n⚡ Power: 10"
pet.TextScaled = true
pet.Parent = menu

local equip = Instance.new("TextButton")
equip.Size = UDim2.new(1, -60, 0, 55)
equip.Position = UDim2.new(0, 30, 1, -75)
equip.Text = "EQUIP"
equip.TextScaled = true
equip.Parent = menu

button.MouseButton1Click:Connect(function()
	menu.Visible = not menu.Visible
end)

pet.MouseButton1Click:Connect(function()
	pet.Text = "✅ 🐉 Dragon\n⭐ Legendary\n⚡ Power: 10"
end)

equip.MouseButton1Click:Connect(function()
	equip.Text = "✅ EQUIPPED"
end)
