local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local pets = ReplicatedStorage:WaitForChild("Pets")

local equippedPets = {}

Players.PlayerAdded:Connect(function(player)

	player.CharacterAdded:Connect(function(character)

		task.wait(1)

		local template = pets:FindFirstChild("Pet")
		if not template then
			warn("Không tìm thấy Pet!")
			return
		end

		-- Xóa Pet cũ
		local old = workspace:FindFirstChild(player.Name .. "_Pet")
		if old then
			old:Destroy()
		end

		-- Clone Pet
		local pet = template:Clone()
		pet.Name = player.Name .. "_Pet"
		pet.Parent = workspace

		local root =
			pet.PrimaryPart
			or pet:FindFirstChild("Body")
			or pet:FindFirstChildWhichIsA("BasePart")

		if not root then
			warn("Pet không có Part!")
			pet:Destroy()
			return
		end

		pet.PrimaryPart = root

		-- Tắt va chạm
		for _, obj in ipairs(pet:GetDescendants()) do
			if obj:IsA("BasePart") then
				obj.CanCollide = false
				obj.Anchored = true
			end
		end

		equippedPets[player] = pet

	end)

end)

Players.PlayerRemoving:Connect(function(player)

	if equippedPets[player] then
		equippedPets[player]:Destroy()
		equippedPets[player] = nil
	end

end)

-- Cho Pet bay theo người chơi
RunService.Heartbeat:Connect(function()

	for player, pet in pairs(equippedPets) do

		if not pet or not pet.Parent then
			continue
		end

		local character = player.Character
		if not character then
			continue
		end

		local hrp = character:FindFirstChild("HumanoidRootPart")
		if not hrp then
			continue
		end

		-- Vị trí phía sau bên phải
		local target =
			hrp.CFrame
			* CFrame.new(3, 1.5, 3)

		local current = pet:GetPivot()

		pet:PivotTo(
			current:Lerp(target, 0.12)
		)

	end

end)
